# Copy this file to ".env" (setup.bat does it for you). NEVER commit ".env".
# Lines starting with # are comments.

# --- Server -----------------------------------------------------------
HOST=127.0.0.1
PORT=5000
# Leave empty in development: a random key is generated once into backend/instance/secret.key.
# In production set a long random value (python -c "import secrets;print(secrets.token_hex(32))").
VOXORA_SECRET_KEY=
VOXORA_JWT_HOURS=12
# Optional: where the SQLite DB + recordings live (default backend/instance)
# VOXORA_INSTANCE_DIR=

# --- Sample-data logins (used only by "seed"; CHANGE them, and change passwords inside the app) ---
SEED_ADMIN_EMAIL=admin@voxora.local
SEED_ADMIN_PASSWORD=ChangeMe-Admin1
SEED_CLIENT_PASSWORD=ChangeMe-Client1

# --- Real providers (FUTURE; adapters are stubs today, see MANUAL_SETUP_AND_NEXT_STEPS.md) ---
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
